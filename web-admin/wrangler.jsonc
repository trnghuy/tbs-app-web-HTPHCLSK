{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tbs-htph-clsk-admin",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tbs-htph-clsk-admin"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tbs-htph-clsk-db",
      "database_id": "807965af-190c-4404-9f32-0043ee77c949"
    }
  ],
  // "r2_buckets": []  ← Bật R2 trong Cloudflare Dashboard rồi bỏ comment
}
